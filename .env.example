# Argus Hub
ARGUS_HUB_PORT=8000

# Argus Probe
ARGUS_AGENT_ID=A-01
ARGUS_HUB_URL=ws://localhost:8000/ws/probe

# VLM (any OpenAI-compatible endpoint)
ARGUS_VLM_URL=http://localhost:8080/v1
ARGUS_VLM_MODEL=gpt-4o-mini
ARGUS_VLM_KEY=no-key

# Timing (ms)
ARGUS_FAST_INTERVAL=1000
ARGUS_SCREEN_INTERVAL=50
